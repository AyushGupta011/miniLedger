# Expo Public API URL
# Choose the URL that matches your development environment:

# Option A: Physical device via Expo Go (Both phone and PC must be on the same Wi-Fi)
# Replace with your computer's local LAN IP (e.g. run `ipconfig` or `ifconfig` to find it)
EXPO_PUBLIC_API_URL=http://192.168.1.9:3000

# Option B: Android Emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Option C: iOS Simulator or Web browser
# EXPO_PUBLIC_API_URL=http://localhost:3000
